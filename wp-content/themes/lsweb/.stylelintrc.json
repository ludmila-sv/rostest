{
  "extends": [
    "@wordpress/stylelint-config/node_modules/stylelint-config-recommended-scss",
	"stylelint-config-standard-scss"
  ],
  "rules": {
	"indentation": "tab",
	"string-quotes": "single",
    "block-no-empty": true,
    "color-no-invalid-hex": true,
    "declaration-colon-space-after": "always",
    "declaration-colon-space-before": "never",
    "function-comma-space-after": "always",
    "function-parentheses-space-inside": "always",
    "media-feature-colon-space-after": "always",
    "media-feature-colon-space-before": "never",
    "media-feature-name-no-vendor-prefix": true,
    "max-empty-lines": 5,
    "number-no-trailing-zeros": true,
    "no-eol-whitespace": true,
    "value-no-vendor-prefix": true,
    "declaration-block-no-duplicate-properties": true,
    "declaration-block-single-line-max-declarations": 1,
    "declaration-block-trailing-semicolon": "always",
    "selector-list-comma-space-before": "never",
    "function-calc-no-unspaced-operator": true,
    "selector-pseudo-element-colon-notation": "single",
    "selector-pseudo-class-parentheses-space-inside": "always",
    "media-feature-parentheses-space-inside": "always",
    "selector-class-pattern": "[-_a-z0-9]+",
	"alpha-value-notation": "number",
	"color-function-notation": "legacy",
	"scss/dollar-variable-empty-line-before": [
		"always",
		{"except": ["first-nested", "after-dollar-variable"]},
		{"ignore": ["after-comment", "inside-single-line-block", "after-dollar-variable"]}
    ]
  }
}